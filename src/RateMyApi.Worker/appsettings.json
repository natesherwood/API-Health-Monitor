{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Npgsql": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ratemyapi;Username=ratemyapi;Password=ratemyapi;Maximum Pool Size=100"
  },
  "WORKER_ID": "auto",
  "WORKER_COUNT": "auto",
  "Worker": {
    "BatchSize": 100,
    "MaxParallelism": 32,
    "PollIntervalMs": 500
  },
  "Evaluation": {
    "WindowMinutes": 5
  },
  "Retention": {
    "Months": 6,
    "PartitionsAhead": 2
  },
  "Stats": {
    "RefreshSeconds": 60
  },
  "Notifications": {
    "MaxAttempts": 5,
    "Webhook": {
      "Url": "",
      "Secret": ""
    },
    "Email": {
      "To": "",
      "From": "ratemyapi@localhost",
      "SmtpHost": "",
      "SmtpPort": 25
    }
  }
}
